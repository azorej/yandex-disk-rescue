# Copy to .env (git-ignored). mise loads it automatically (see [env] in mise.toml).
# Yandex OAuth token; takes precedence over the stored token file.
# If set but blank, it is an error, not a fallback to the stored file.
# YANDEX_DISK_RESCUE_TOKEN=
# Base URL of the Yandex Disk REST API.
# YANDEX_DISK_RESCUE_API_URL=https://cloud-api.yandex.net
# ClientID of the Yandex OAuth app 'auth login' authorizes; the default is the built-in app.
# YANDEX_DISK_RESCUE_CLIENT_ID=
